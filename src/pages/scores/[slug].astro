---
// src/pages/scores/[slug].astro
// ── One page per piece, built for people searching for the sheet ─────────
// Targets: "[piece] piano sheet music", "[piece] piano score pdf".
// The matching /videos/[slug] page stays the place for the full video notes;
// this page leads with the download.
import CoffeeButton from "../../components/CoffeeButton.astro";
import ListenPlayer from "../../components/ListenPlayer.astro";
import SceneHeader from "../../components/SceneHeader.astro";
import { trackForPiece } from "../../lib/listen";
import Layout from "../../layouts/Layout.astro";
import { pieces, relatedPieces, linkArranger, orderedLinks, linkLabel, type Piece } from "../../lib/scores";

export async function getStaticPaths() {
  return pieces.map((piece) => ({
    params: { slug: piece.slug },
    props:  { piece },
  }));
}

const { piece } = Astro.props as { piece: Piece };
const latest   = piece.versions[0];
// Every arranger across all links, so a two-part score credits both
const credits  = [...new Set(piece.versions.flatMap((v) => orderedLinks(v).map((l) => linkArranger(v, l))).filter(Boolean))] as string[];
const credit   = credits.length ? credits.slice(0, -1).join(", ") + (credits.length > 1 ? " and " : "") + credits[credits.length - 1] : null;
const context  = [piece.game, piece.region].filter(Boolean).join(" · ");
const related  = relatedPieces(piece);
// "More from Inazuma" only when every card really is from Inazuma; small
// regions get topped up with other pieces, so each card names its region
const allSameRegion = !!piece.region && related.every((p) => p.region === piece.region);

const siteUrl  = "https://bigpianosmallpiano.com";
const pageUrl  = `${siteUrl}/scores/${piece.slug}`;
// enablejsapi lets the listen player pause the video when the track starts
const embedUrl = `https://www.youtube.com/embed/${latest.videoId}?enablejsapi=1`;
const track    = trackForPiece(piece);
const channelUrl = "https://www.youtube.com/channel/UCsKtOGplqKz3uGt9XD8VexQ";

const fromGame = piece.game ? ` from ${piece.game}` : "";
const title    = `${piece.name} Piano Sheet Music (Free)`;
const description =
  `Free piano sheet music for ${piece.name}${fromGame}` +
  (credit ? `, arranged by ${credit}` : "") +
  `. Download the score and watch the piano cover by Big Piano Small Piano.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type":    "MusicComposition",
    "name":     piece.name,
    "url":      pageUrl,
    ...(credits.length && { "musicArrangement": { "@type": "MusicComposition", "name": `${piece.name} (piano)`, "composer": credits.map((name) => ({ "@type": "Person", "name": name })) } }),
    "subjectOf": piece.versions.map((v) => ({
      "@type":        "VideoObject",
      "name":         v.title,
      "thumbnailUrl": [v.thumbnail],
      "uploadDate":   v.publishedAt,
      "embedUrl":     `https://www.youtube.com/embed/${v.videoId}`,
      "url":          `https://www.youtube.com/watch?v=${v.videoId}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type":    "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home",        "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "Free Scores", "item": `${siteUrl}/scores` },
      { "@type": "ListItem", "position": 3, "name": piece.name,    "item": pageUrl },
    ],
  },
];
---

<Layout
  floatingCoffee={false}
  title={title}
  description={description}
  image={latest.thumbnail || "/og-default.jpg"}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ── Title over the region painting ─────────────────────────────────── -->
  <SceneHeader region={piece.region} eyebrow="Free piano sheet music" title={piece.name}>
    <nav slot="top" class="text-xs text-ivory/70 flex items-center gap-1.5 mb-6 drop-shadow whitespace-nowrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gold transition-colors">Home</a>
      <span>/</span>
      <a href="/scores" class="hover:text-gold transition-colors">Free Scores</a>
      <span class="hidden sm:inline">/</span>
      <span class="hidden sm:inline text-ivory/60 truncate max-w-xs">{piece.name}</span>
    </nav>
    {context && <p class="mt-3 text-sm text-ivory/75 drop-shadow">{context}</p>}
  </SceneHeader>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 pb-8 sm:pb-12">

    <!-- ── Downloads (the reason people land here) ───────────────────────── -->
    <section class="mb-10 bg-surface rounded-xl border border-gold/20 p-5 sm:p-6" aria-labelledby="downloads">
      <h2 id="downloads" class="font-display text-xl font-semibold text-ivory mb-4">Download the score</h2>
      <ul class="space-y-3">
        {piece.versions.flatMap((v) =>
          orderedLinks(v).map((link: string, i: number) => (
            <li class="flex flex-col sm:flex-row sm:items-center gap-3 border-b border-surface-border pb-3 last:border-0 last:pb-0">
              <a
                href={link}
                target="_blank" rel="noopener noreferrer"
                class="btn-gold self-start"
                aria-label={`Download ${piece.name} piano score from ${linkLabel(link)}`}
              >
                Download from {linkLabel(link)} ↗
              </a>
              <div class="text-sm text-ivory-muted sm:ml-auto sm:text-right">
                {linkArranger(v, link) && <p>Arranged by {linkArranger(v, link)}</p>}
                {(piece.versions.length > 1 || v.scoreLinks.length > 1) && (
                  <p class="text-xs">
                    {v.scoreLinks.length > 1 ? `Part ${i + 1} · ` : ""}from the {new Date(v.publishedAt).getFullYear()} cover
                  </p>
                )}
              </div>
            </li>
          ))
        )}
      </ul>
      <p class="mt-4 text-xs text-ivory-muted">
        Free to download. {credit && credit !== "Big Piano Small Piano"
          ? `The ${credits.length > 1 ? "arrangements belong" : "arrangement belongs"} to ${credit}, so please credit them if you share or perform it.`
          : "Please credit Big Piano Small Piano if you share it."}
      </p>
    </section>

    {track && <ListenPlayer track={track} channelUrl={channelUrl} />}

    <!-- ── Hear it ───────────────────────────────────────────────────────── -->
    <section class="mb-10" aria-labelledby="listen">
      <h2 id="listen" class="font-display text-xl font-semibold text-ivory mb-4">{track ? "Watch the cover" : "Hear how it sounds"}</h2>
      <div class="relative aspect-video w-full rounded-xl overflow-hidden border border-surface-border shadow-card mb-4">
        <iframe
          src={embedUrl}
          title={latest.title}
          class="absolute inset-0 w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <ul class="text-sm space-y-1">
        {piece.versions.map((v) => (
          <li>
            <a href={`/videos/${v.slug}`} class="text-gold hover:text-gold-light transition-colors">
              {piece.versions.length > 1 ? v.title : "Video notes and description"} →
            </a>
          </li>
        ))}
      </ul>
    </section>

    <CoffeeButton
      variant="inline"
      message="This score is free. If it helps your playing, a coffee keeps more of them coming."
    />
  </article>

  <!-- ── More scores ─────────────────────────────────────────────────────── -->
  {related.length > 0 && (
    <>
      <hr class="gold-rule max-w-4xl mx-auto" />
      <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
        <p class="text-gold text-xs tracking-[0.2em] uppercase font-mono mb-2">
          {allSameRegion ? `More from ${piece.region}` : piece.game ? `More ${piece.game}` : "More free scores"}
        </p>
        <h2 class="font-display text-2xl font-semibold text-ivory mb-6">More piano sheets</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
          {related.map((p) => (
            <a
              href={`/scores/${p.slug}`}
              class="group bg-surface rounded-xl border border-surface-border overflow-hidden hover:border-gold/40 transition-all duration-300 flex flex-col"
            >
              {p.versions[0].thumbnail && (
                <div class="aspect-video overflow-hidden">
                  <img
                    src={p.versions[0].thumbnail}
                    alt=""
                    width="320" height="180"
                    class="w-full h-full object-cover motion-safe:group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-3">
                <p class="text-sm font-display text-ivory/80 group-hover:text-gold transition-colors line-clamp-2 leading-snug">
                  {p.name}
                </p>
                {!allSameRegion && p.region && (
                  <p class="mt-1 text-[0.65rem] tracking-[0.15em] uppercase font-mono text-ivory-muted">{p.region}</p>
                )}
              </div>
            </a>
          ))}
        </div>
        <p class="mt-6 text-sm">
          <a href="/scores" class="text-gold hover:text-gold-light transition-colors">See all free piano scores →</a>
        </p>
      </section>
    </>
  )}
</Layout>
