---
// src/pages/videos/[slug].astro
// ── Individual video post — one page per YouTube video ───────────────────
import CoffeeButton from "../../components/CoffeeButton.astro";
import Layout from "../../layouts/Layout.astro";
import videos from "../../data/videos.json";
import scores from "../../data/scores.json";
import { pieceByVideoId, linkArranger, orderedLinks } from "../../lib/scores";
import { videoRole, tracklist, collectionRegion } from "../../lib/videoPages";

export async function getStaticPaths() {
  return videos.map((video) => ({
    params: { slug: video.slug },
    props:  { video },
  }));
}

const { video } = Astro.props;

// Find any scores associated with this video
const videoScores = scores.filter((s) => s.videoId === video.videoId);
const piece       = pieceByVideoId.get(video.videoId);

// Role decides canonical / noindex (see lib/videoPages.ts)
const role   = videoRole(video);
const rows   = role.kind === "collection" ? tracklist(video) : [];
const region = role.kind === "collection" ? collectionRegion(rows, video.title) : null;
const scorePage = role.kind === "score" ? `/scores/${role.piece.slug}/` : null;

// Build a clean meta description from the first 155 chars of description
const metaDescription = video.description
  .replace(/\n+/g, " ")
  .replace(/\s{2,}/g, " ")
  .trim()
  .slice(0, 155);

// Format date for display and schema
const publishDate     = new Date(video.publishedAt);
const displayDate     = publishDate.toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric",
});

// Related videos (exclude self, take up to 3)
const related = videos
  .filter((v) => v.videoId !== video.videoId)
  .slice(0, 3);

const siteUrl   = "https://bigpianosmallpiano.com";
const pageUrl   = `${siteUrl}/videos/${video.slug}/`;
const embedUrl  = `https://www.youtube.com/embed/${video.videoId}`;
const watchUrl  = `https://www.youtube.com/watch?v=${video.videoId}`;

// JSON-LD VideoObject schema — tells Google this is a video page
const jsonLd = {
  "@context":     "https://schema.org",
  "@type":        "VideoObject",
  "name":         video.title,
  "description":  metaDescription,
  "thumbnailUrl": [video.thumbnail],
  "uploadDate":   video.publishedAt,
  "embedUrl":     embedUrl,
  "url":          watchUrl,
  "author": {
    "@type": "Person",
    "name":  "Big Piano Small Piano",
    "url":   "https://www.youtube.com/channel/UCsKtOGplqKz3uGt9XD8VexQ",
  },
  "publisher": {
    "@type": "Organization",
    "name":  "Big Piano Small Piano",
    "url":   siteUrl,
  },
  ...(video.viewCount > 0 && {
    "interactionStatistic": {
      "@type":                 "InteractionCounter",
      "interactionType":       "https://schema.org/WatchAction",
      "userInteractionCount":  video.viewCount,
    },
  }),
};
---

<Layout
  floatingCoffee={false}
  title={`${video.title} | Big Piano Small Piano`}
  description={metaDescription || `Watch ${video.title}, a piano cover by Big Piano Small Piano.`}
  image={video.thumbnail || "/og-default.jpg"}
  type="video.other"
  canonical={scorePage ?? undefined}
  noindex={role.kind === "thin"}
>
  <!-- ── JSON-LD ─────────────────────────────────────────────────────────── -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ── Breadcrumb ──────────────────────────────────────────────────────── -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-6">
    <nav class="text-xs text-ivory-muted flex items-center gap-1.5" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gold transition-colors">Home</a>
      <span>/</span>
      <a href="/#videos" class="hover:text-gold transition-colors">Videos</a>
      <span>/</span>
      <span class="text-ivory/60 truncate max-w-xs">{video.title}</span>
    </nav>
  </div>

  <!-- ══════════════════════════ MAIN CONTENT ═════════════════════════════════ -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- Title block -->
    <header class="mb-8">
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-ivory leading-tight mb-3">
        {video.title}
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-ivory-muted">
        <time datetime={video.publishedAt}>{displayDate}</time>
        {video.viewCount > 0 && (
          <span>
            {video.viewCount.toLocaleString()} views
          </span>
        )}
        <a
          href={watchUrl}
          target="_blank" rel="noopener noreferrer"
          class="text-gold hover:text-gold-light transition-colors"
        >
          Watch on YouTube ↗
        </a>
      </div>
    </header>

    <!-- ── Video embed ──────────────────────────────────────────────────── -->
    <div class="relative aspect-video w-full rounded-xl overflow-hidden border border-surface-border shadow-card mb-10">
      <iframe
        src={embedUrl}
        title={video.title}
        class="absolute inset-0 w-full h-full"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    <!-- ── Score page call-out ─────────────────────────────────────────── -->
    {scorePage && role.kind === "score" && (
      <a
        href={scorePage}
        class="mb-10 flex items-center justify-between gap-4 rounded-xl border border-gold/40 bg-surface px-5 py-4 sm:px-6 hover:border-gold transition-colors group"
      >
        <span>
          <span class="block font-display text-lg sm:text-xl font-semibold text-ivory group-hover:text-gold transition-colors">
            Sheet music + listen
          </span>
          <span class="block text-sm text-ivory-muted">
            Free score, the audio and more {role.piece.region ?? ""} pieces on the {role.piece.name} page
          </span>
        </span>
        <span class="text-gold text-2xl flex-shrink-0" aria-hidden="true">→</span>
      </a>
    )}

    <!-- ── Tracklist (compilations) ────────────────────────────────────── -->
    {rows.length > 0 && (
      <section class="mb-10 bg-surface rounded-xl border border-gold/20 p-5 sm:p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
          <h2 class="font-display text-xl font-semibold text-ivory">Tracklist</h2>
          {region && (
            <a href={region.href} class="text-sm text-gold hover:text-gold-light transition-colors">
              Listen to the {region.name} playlist →
            </a>
          )}
        </div>
        <ol class="divide-y divide-surface-border text-sm">
          {rows.map((r) => (
            <li class="flex items-baseline gap-3 py-2">
              <a
                href={`${watchUrl}&t=${r.seconds}s`}
                target="_blank" rel="noopener noreferrer"
                class="font-mono text-xs text-ivory-muted hover:text-gold w-16 flex-shrink-0 tabular-nums"
              >{r.time}</a>
              <span class="min-w-0">
                {r.piece
                  ? <a href={`/scores/${r.piece.slug}/`} class="text-ivory hover:text-gold transition-colors">{r.name}</a>
                  : <span class="text-ivory/80">{r.name}</span>}
                {r.note && <span class="text-ivory-muted"> · {r.note}</span>}
                {r.piece && <span class="text-gold text-xs ml-1">sheet ♪</span>}
              </span>
            </li>
          ))}
        </ol>
        <p class="mt-4 text-xs text-ivory-muted">
          Names with a ♪ link to their free score page. Timestamps open the video at that track.
          {!region && <> Or play the <a href="/playlist/" class="text-gold hover:underline">full piano playlist</a>.</>}
        </p>
      </section>
    )}

    <!-- ── Piano Scores block (if any found) ───────────────────────────── -->
    {videoScores.length > 0 && (
      <section class="mb-10 bg-surface rounded-xl border border-gold/20 p-5 sm:p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-gold text-lg">♪</span>
          <h2 class="font-display text-xl font-semibold text-ivory">Free Piano Scores</h2>
        </div>
        <ul class="space-y-3">
          {videoScores.flatMap((s) =>
            orderedLinks(s).map((link: string, i: number) => (
              <li class="flex flex-col sm:flex-row sm:items-center gap-2 text-sm border-b border-surface-border pb-3 last:border-0 last:pb-0">
                <a
                  href={link}
                  target="_blank" rel="noopener noreferrer"
                  class="text-gold hover:text-gold-light transition-colors break-all"
                >
                  Download score {s.scoreLinks.length > 1 ? i + 1 : ""} ↗
                </a>
                {linkArranger(s, link) && (
                  <span class="text-ivory-muted sm:ml-auto flex-shrink-0">
                    Arranged by {linkArranger(s, link)}
                  </span>
                )}
              </li>
            ))
          )}
        </ul>
        <p class="mt-4 text-xs text-ivory-muted">
          {piece && <>See the <a href={`/scores/${piece.slug}/`} class="text-gold hover:underline">{piece.name} score page</a>, or </>}browse <a href="/scores/" class="text-gold hover:underline">all free piano scores</a>.
        </p>
      </section>
    )}

    <!-- ── Description ─────────────────────────────────────────────────── -->
    {rows.length > 0 ? (
      <details class="mb-10 group">
        <summary class="cursor-pointer font-display text-lg text-ivory-muted hover:text-gold">YouTube description</summary>
        <div class="mt-3 text-ivory/70 text-sm leading-relaxed whitespace-pre-wrap bg-surface rounded-xl border border-surface-border p-5 sm:p-6">
          {video.description}
        </div>
      </details>
    ) : (
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-ivory mb-4">About this video</h2>
        <div class="text-ivory/70 text-sm leading-relaxed whitespace-pre-wrap bg-surface rounded-xl border border-surface-border p-5 sm:p-6">
          {video.description}
        </div>
      </section>
    )}
  <CoffeeButton
  variant="inline"
  message="Enjoyed this piece? You can support more free piano covers and sheet music for the price of a coffee."
  />
  </article>

  <hr class="gold-rule max-w-4xl mx-auto" />
  <!-- ══════════════════════════ RELATED VIDEOS ═══════════════════════════════ -->
  {related.length > 0 && (
    <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <p class="text-gold text-xs tracking-[0.2em] uppercase font-mono mb-2">More from the channel</p>
      <h3 class="font-display text-2xl font-semibold text-ivory mb-6">Related Videos</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {related.map((v) => (
          <a
            href={`/videos/${v.slug}/`}
            class="group bg-surface rounded-xl border border-surface-border overflow-hidden hover:border-gold/40 transition-all duration-300 flex flex-col"
          >
            {v.thumbnail && (
              <div class="aspect-video overflow-hidden">
                <img
                  src={v.thumbnail}
                  alt={v.title}
                  width="320" height="180"
                  class="w-full h-full object-cover motion-safe:group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            )}
            <p class="p-3 text-sm font-display text-ivory/80 group-hover:text-gold transition-colors line-clamp-2 leading-snug">
              {v.title}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

</Layout>
