---
// src/pages/playlist/natlan.astro
// ── Natlan region piano playlist: SEO landing page ─────────────────────
import CoffeeButton from "../../components/CoffeeButton.astro";
import PlaylistPlayer from "../../components/PlaylistPlayer.astro";
import SceneHeader from "../../components/SceneHeader.astro";
import Layout from "../../layouts/Layout.astro";
import allTracks from "../../data/tracks.json";

// Listening order: a bright, easy day among the tribes, then dusk and the
// partings, then the war and Capitano's story, ending on the night pieces.
// Tracks not listed here go last, A to Z. A first pass: reorder freely.
const ORDER = [
  "Cozy in the Light",
  "Introduction to a Little Friend",
  "Whirl of Chalchiuhtlicue",
  "Fluttering Upon the Wind",
  "Rippling Reveries",
  "Teleoco Bay",
  "Legendary Tonatiuh",
  "Eventide Chant",
  "As the Feather Falls",
  "After So Many Words",
  "A Distant Farewell",
  "Beyond the Flute's Whispers",
  "Metaphor for Calamity",
  "His Rest Was in the Night",
  "The Ode of Resurrection",
  "To the End of All Wars",
  "The Nocturnal Firmament's Luster",
  "Frosted Hue of Stars",
  "A Night of their Own",
  "The Nights' Wish",
];
const rank = (title: string) => {
  const i = ORDER.indexOf(title);
  return i === -1 ? ORDER.length : i;
};

const tracks = allTracks
  .filter((t) => t.category === "Natlan")
  .sort((a, b) => rank(a.title) - rank(b.title) || a.title.localeCompare(b.title));

const totalMinutes = Math.round(tracks.reduce((sum, t) => sum + t.duration, 0) / 60);

const siteUrl = "https://bigpianosmallpiano.com";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicPlaylist",
  "name": "Natlan Piano Music | Big Piano Small Piano",
  "description":
    "Natlan OST piano covers from Genshin Impact, streamed continuously. Calming piano music to study, sleep or relax to, with free sheet music.",
  "url": `${siteUrl}/playlist/natlan`,
  "numTracks": tracks.length,
  "track": tracks.map((t) => ({
    "@type": "MusicRecording",
    "name": t.title,
    "duration": `PT${Math.floor(t.duration / 60)}M${t.duration % 60}S`,
    "associatedMedia": { "@type": "MediaObject", "contentUrl": t.url },
  })),
};
---

<Layout
  floatingCoffee={false}
  title="Natlan Piano Music to Study &amp; Sleep to: Free Genshin Playlist"
  description={`${tracks.length} Natlan OST piano covers from Genshin Impact, about ${totalMinutes} minutes of calming music to study, sleep or relax to. Free sheet music for most tracks. No ads, no sign-up.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO -->
  <SceneHeader region="Natlan" eyebrow="Genshin Impact · Region" title="Natlan Piano">
    <p class="mt-3 text-ivory/80 text-sm max-w-md leading-relaxed drop-shadow">
      {tracks.length} original piano covers &middot; ~{totalMinutes} minutes &middot; free to stream, no ads.
    </p>
    <a
      href="/playlist/"
      class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-ivory/25 bg-ebony/60 backdrop-blur-sm text-ivory/80 hover:border-gold/40 hover:text-gold transition-colors"
    >
      &larr; All regions playlist
    </a>
  </SceneHeader>

  <!-- INTRO -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-8">
    <p class="text-ivory/60 text-sm leading-relaxed">
      Natlan is the nation of fire and war, added in Genshin Impact version 5.0: the tribes of the
      volcano, the Flower-Feather Clan's high cliffs, Teleoco Bay and the Night Kingdom below. Its music
      swings from bright, rhythmic tunes to quiet flutes at dusk and the heavy story of the Abyss war
      and the Captain. These are my piano covers of {tracks.length} Natlan themes, in order from an easy
      day among the tribes to the war and a long, starry night, for studying, reading or drifting off.
      Most have free sheet music: tap Sheet music on any track.
    </p>
  </section>

  <PlaylistPlayer tracks={tracks} showCategories={false} shuffle={false}>
    <div slot="footer">
      <CoffeeButton
        variant="inline"
        message="Every Natlan cover here is free to stream. If it's keeping you company while you study or wind down, a coffee helps keep it going."
      />
    </div>
  </PlaylistPlayer>
</Layout>
