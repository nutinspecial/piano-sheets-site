---
// src/pages/playlist/mondstadt.astro
// ── Mondstadt region piano playlist: SEO landing page ─────────────────────
import CoffeeButton from "../../components/CoffeeButton.astro";
import PlaylistPlayer from "../../components/PlaylistPlayer.astro";
import SceneHeader from "../../components/SceneHeader.astro";
import Layout from "../../layouts/Layout.astro";
import allTracks from "../../data/tracks.json";

// Listening order: morning in the city of wind, a day out at Springvale and
// with friends, the cold of Dragonspine, then night and the hour before dawn.
// Tracks not listed here go last, A to Z. A first pass: reorder freely.
const ORDER = [
  "A New Day with Hope",
  "Pure Sky",
  "Another Day in Mondstadt",
  "Whence the Flow Cometh",
  "Ripples of Daydream",
  "The Luckiest Child",
  "Tender Strength",
  "Separate Ways",
  "Fragile Fantasy",
  "Moonlit Wilderness",
  "Midnight in Mondstadt",
  "Before Dawn, at the Winery",
];
const rank = (title: string) => {
  const i = ORDER.indexOf(title);
  return i === -1 ? ORDER.length : i;
};

const tracks = allTracks
  .filter((t) => t.category === "Mondstadt")
  .sort((a, b) => rank(a.title) - rank(b.title) || a.title.localeCompare(b.title));

const totalMinutes = Math.round(tracks.reduce((sum, t) => sum + t.duration, 0) / 60);

const siteUrl = "https://bigpianosmallpiano.com";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicPlaylist",
  "name": "Mondstadt Piano Music | Big Piano Small Piano",
  "description":
    "Mondstadt OST piano covers from Genshin Impact, streamed continuously. Calming piano music to study, sleep or relax to, with free sheet music.",
  "url": `${siteUrl}/playlist/mondstadt`,
  "numTracks": tracks.length,
  "track": tracks.map((t) => ({
    "@type": "MusicRecording",
    "name": t.title,
    "duration": `PT${Math.floor(t.duration / 60)}M${t.duration % 60}S`,
    "associatedMedia": { "@type": "MediaObject", "contentUrl": t.url },
  })),
};
---

<Layout
  floatingCoffee={false}
  title="Mondstadt Piano Music to Study &amp; Sleep to: Free Genshin Playlist"
  description={`${tracks.length} Mondstadt OST piano covers from Genshin Impact, about ${totalMinutes} minutes of calming music to study, sleep or relax to. Free sheet music for most tracks. No ads, no sign-up.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO -->
  <SceneHeader region="Mondstadt" eyebrow="Genshin Impact · Region" title="Mondstadt Piano">
    <p class="mt-3 text-ivory/80 text-sm max-w-md leading-relaxed drop-shadow">
      {tracks.length} original piano covers &middot; ~{totalMinutes} minutes &middot; free to stream, no ads.
    </p>
    <a
      href="/playlist/"
      class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-ivory/25 bg-ebony/60 backdrop-blur-sm text-ivory/80 hover:border-gold/40 hover:text-gold transition-colors"
    >
      &larr; All regions playlist
    </a>
  </SceneHeader>

  <!-- INTRO -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-8">
    <p class="text-ivory/60 text-sm leading-relaxed">
      Mondstadt is the city of freedom and wind, the first nation you reach in Genshin Impact: the
      windmills and cathedral, Springvale, Starfell Lake, the Dawn Winery and the snow of Dragonspine.
      Its music is light and open, with gentle strings, wind and a lot of sunlight. These are my piano
      covers of {tracks.length} Mondstadt themes, in order from a new morning in the city to a quiet
      midnight and the hour before dawn at the winery, for studying, reading or drifting off. Most have
      free sheet music: tap Sheet music on any track.
    </p>
  </section>

  <PlaylistPlayer tracks={tracks} showCategories={false} shuffle={false}>
    <div slot="footer">
      <CoffeeButton
        variant="inline"
        message="Every Mondstadt cover here is free to stream. If it's keeping you company while you study or wind down, a coffee helps keep it going."
      />
    </div>
  </PlaylistPlayer>
</Layout>
