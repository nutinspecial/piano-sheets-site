---
// src/pages/playlist/nod-krai.astro
// ── Nod Krai region piano playlist — SEO landing page ────────────────────
import CoffeeButton from "../../components/CoffeeButton.astro";
import PlaylistPlayer from "../../components/PlaylistPlayer.astro";
import SceneHeader from "../../components/SceneHeader.astro";
import Layout from "../../layouts/Layout.astro";
import allTracks from "../../data/tracks.json";

// Listening order: arrival and daytime, then dusk, night and the Columbina
// pieces, ending on the lullaby. Tracks not listed here go last, A to Z.
const ORDER = [
  "Nod-Krai",
  "Through the Silent Frostbound Night",
  "Gladsome Ramble",
  "Half-Finished Heaven",
  "Fresh Baked Egg Rolls",
  "After Tea Party",
  "Shimmering Water Like Flickering Souls",
  "Fields After Dusk",
  "Dreams of Joy Departed",
  "Vestige of Hurtling Foam",
  "Disorder and Early Sorrow",
  "Unpromised Farewell",
  "A Sitting on a Gate",
  "A Lie of Aila",
  "Companion on a Rainy Night",
  "Raven Beneath the Tender Moon",
  "To the Glowing Night",
  "Where She Dwells",
  "To Where She Flies",
  "Enigma in the Lunar Cradle",
  "Beyond the Full Moonlight",
  "Lullaby of the New Moon (I): Somnias a Luna",
];
const rank = (title: string) => {
  const i = ORDER.indexOf(title);
  return i === -1 ? ORDER.length : i;
};

const tracks = allTracks
  .filter((t) => t.category === "Nod Krai")
  .sort((a, b) => rank(a.title) - rank(b.title) || a.title.localeCompare(b.title));

const totalMinutes = Math.round(tracks.reduce((sum, t) => sum + t.duration, 0) / 60);

const siteUrl = "https://bigpianosmallpiano.com";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicPlaylist",
  "name": "Nod Krai Piano Music | Big Piano Small Piano",
  "description":
    "Every Nod Krai OST covered on piano, streamed continuously. Calming Genshin Impact music to study, sleep or relax to.",
  "url": `${siteUrl}/playlist/nod-krai/`,
  "numTracks": tracks.length,
  "track": tracks.map((t) => ({
    "@type": "MusicRecording",
    "name": t.title,
    "duration": `PT${Math.floor(t.duration / 60)}M${t.duration % 60}S`,
    "associatedMedia": { "@type": "MediaObject", "contentUrl": t.url },
  })),
};
---

<Layout
  floatingCoffee={false}
  title="Nod Krai Piano Music to Study &amp; Sleep to: Free Playlist"
  description={`All ${tracks.length} Nod Krai OSTs covered on piano, about ${totalMinutes} minutes of calming Genshin Impact music to study, sleep or relax to. Free to stream, no ads, no sign-up.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO -->
  <SceneHeader region="Nod Krai" eyebrow="Genshin Impact · Region" title="Nod Krai Piano">
    <p class="mt-3 text-ivory/80 text-sm max-w-md leading-relaxed drop-shadow">
      {tracks.length} original piano covers &middot; ~{totalMinutes} minutes &middot; free to stream, no ads.
    </p>
    <a
      href="/playlist/"
      class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-ivory/25 bg-ebony/60 backdrop-blur-sm text-ivory/80 hover:border-gold/40 hover:text-gold transition-colors"
    >
      &larr; All regions playlist
    </a>
  </SceneHeader>

  <!-- INTRO -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-8">
    <p class="text-ivory/60 text-sm leading-relaxed">
      Nod Krai is the northern region introduced in Genshin Impact version 6.0:
      Hiisi Island, the Silvermoon Hall, the Barrowmoss Barrens and the Eye of
      Kratti. Its soundtrack leans quiet and wistful: sparse melodies, cold air,
      a music box left running. These are my piano covers of those themes, in
      order from a bright first day on the island to a moonlit lullaby, for
      studying, reading or drifting off. Press play, or shuffle the whole thing.
    </p>
  </section>

  <PlaylistPlayer tracks={tracks} showCategories={false} shuffle={false}>
    <div slot="footer">
      <CoffeeButton
        variant="inline"
        message="Every Nod Krai cover here is free to stream. If it's keeping you company while you study or wind down, a coffee helps keep it going."
      />
    </div>
  </PlaylistPlayer>
</Layout>
