---
// src/pages/playlist.astro
// ── Ambient piano playlist: browse/search + continuous shuffle player ─────
import CoffeeButton from "../components/CoffeeButton.astro";
import PlaylistPlayer from "../components/PlaylistPlayer.astro";
import Layout from "../layouts/Layout.astro";
import tracks from "../data/tracks.json";

const totalMinutes = Math.round(tracks.reduce((sum, t) => sum + t.duration, 0) / 60);

const nodKraiCount = tracks.filter((t) => t.category === "Nod Krai").length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicPlaylist",
  "name": "Big Piano Small Piano — Ambient Piano Playlist",
  "description": "Free ambient piano music to study, sleep or relax to. Original piano covers, streamed continuously.",
  "url": "https://bigpianosmallpiano.com/playlist",
  "numTracks": tracks.length,
};
---

<Layout
  floatingCoffee={false}
  title="Piano Music for Studying &amp; Sleeping — Free Playlist"
  description="Free ambient piano playlist — hundreds of original piano covers to study, sleep or relax to. Search, filter by mood, and stream continuously. No ads, no sign-up."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-surface-border">
    <div class="absolute inset-0 bg-keys-pattern opacity-50 pointer-events-none"></div>
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold to-transparent"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12 text-center flex flex-col items-center gap-2">
      <p class="text-gold text-xs tracking-[0.25em] uppercase font-mono">Ambient piano</p>
      <h1 class="font-display text-4xl sm:text-5xl font-semibold text-ivory leading-tight">
        Piano <span class="italic text-gold">Playlist</span>
      </h1>
      <p class="text-ivory-muted text-sm max-w-md leading-relaxed">
        {tracks.length} original piano covers &middot; ~{totalMinutes} minutes &middot; free to stream, no ads.
      </p>
      {nodKraiCount > 0 && (
        <a
          href="/playlist/nod-krai"
          class="mt-2 inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-gold/40 bg-gold/10 text-gold hover:bg-gold/20 transition-colors"
        >
          ❄ Nod Krai region playlist ({nodKraiCount}) &rarr;
        </a>
      )}
    </div>
  </section>

  <PlaylistPlayer tracks={tracks}>
    <div slot="footer">
      <CoffeeButton
        variant="inline"
        message="This whole playlist is free to stream — if it's keeping you company while you study or wind down, a coffee helps keep it going."
      />
    </div>
  </PlaylistPlayer>
</Layout>
