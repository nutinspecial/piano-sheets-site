---
// src/pages/playlist.astro
// ── Ambient piano playlist: browse/search + continuous shuffle player ─────
import CoffeeButton from "../components/CoffeeButton.astro";
import PlaylistPlayer from "../components/PlaylistPlayer.astro";
import SceneHeader from "../components/SceneHeader.astro";
import Layout from "../layouts/Layout.astro";
import tracks from "../data/tracks.json";
import { pieces } from "../lib/scores";
import { scoresByTrack } from "../lib/listen";

const totalMinutes = Math.round(tracks.reduce((sum, t) => sum + t.duration, 0) / 60);


const siteUrl = "https://bigpianosmallpiano.com";
const scorePage = new Map<string, string>();
for (const [id, piece] of scoresByTrack(pieces)) scorePage.set(id, `${siteUrl}/scores/${piece.slug}/`);

// Region chips that have their own page offer a link to it
const regionPages = { "Mondstadt": "/playlist/mondstadt/", "Liyue": "/playlist/liyue/", "Inazuma": "/playlist/inazuma/", "Sumeru": "/playlist/sumeru/", "Fontaine": "/playlist/fontaine/", "Natlan": "/playlist/natlan/", "Nod Krai": "/playlist/nod-krai/", "Snezhnaya": "/playlist/snezhnaya/" };
const regionPills = Object.entries(regionPages)
  .map(([name, href]) => ({ name, href, count: tracks.filter((t) => t.category === name).length }))
  .filter((r) => r.count > 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicPlaylist",
  "name": "Genshin Impact Piano Playlist | Big Piano Small Piano",
  "description": "Calm piano covers of Genshin Impact music, plus anime, pop and other games, streamed continuously. Free sheet music for most tracks.",
  "url": `${siteUrl}/playlist/`,
  "numTracks": tracks.length,
  "track": tracks.map((t) => ({
    "@type": "MusicRecording",
    "name": t.title,
    "duration": `PT${Math.floor(t.duration / 60)}M${t.duration % 60}S`,
    "byArtist": { "@type": "MusicGroup", "name": "Big Piano Small Piano" },
    ...(scorePage.has(t.id) && { "url": scorePage.get(t.id) }),
  })),
};
---

<Layout
  floatingCoffee={false}
  title="Piano Music for Studying &amp; Sleeping: Free Playlist"
  description="Free ambient piano playlist with hundreds of original piano covers to study, sleep or relax to. Search, filter by mood, and stream continuously. No ads, no sign-up."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO -->
  <SceneHeader region="Gate" eyebrow="Ambient piano" title="Piano Playlist">
    <p class="mt-3 text-ivory/90 text-sm sm:text-base max-w-lg leading-relaxed drop-shadow">
      Calm piano covers of Genshin Impact music, plus anime, pop and other games. Free sheet music for most tracks.
    </p>
    <p class="mt-1.5 text-ivory/70 text-xs sm:text-sm drop-shadow">
      {tracks.length} covers &middot; ~{totalMinutes} minutes &middot; free to stream, no ads
    </p>
    <!-- One pill per region that has its own page -->
    <div class="mt-4 flex flex-wrap gap-2">
      {regionPills.map((r) => (
        <a
          href={r.href}
          class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-gold/40 bg-ebony/60 backdrop-blur-sm text-gold hover:bg-gold/20 transition-colors"
        >
          {r.name} playlist, {r.count} tracks &rarr;
        </a>
      ))}
    </div>
  </SceneHeader>

  <!-- The header painting follows the region chip. Inline + delegated so it
       also catches the chip that ?region= presses on load. -->
  <script is:inline>
    document.addEventListener("click", function (e) {
      var chip = e.target.closest && e.target.closest(".chip-btn");
      var scene = document.getElementById("scene");
      if (!chip || !scene) return;
      var painted = ["fontaine", "inazuma", "liyue", "mondstadt", "natlan", "nod-krai", "snezhnaya", "sumeru"];
      // All, the groups and non-region chips show the gate above the clouds
      var key = (chip.dataset.category || "").toLowerCase().replace(/[^a-z]+/g, "-");
      if (painted.indexOf(key) === -1) key = "gate";
      if (scene.dataset.art === key) return;
      scene.dataset.art = key;
      var img = scene.querySelector(".scene-art img"), src = scene.querySelector(".scene-art source");
      img.style.opacity = "0";
      setTimeout(function () {
        img.onload = function () { img.style.opacity = "1"; };
        src.srcset = "/art/" + key + "-m.webp";
        img.src = "/art/" + key + ".webp";
      }, 300);
    }, true);
  </script>

  <PlaylistPlayer tracks={tracks} regionPages={regionPages}>
    <div slot="footer">
      <section class="mb-8 text-ivory/70 text-sm leading-relaxed space-y-3" aria-labelledby="about-playlist">
        <h2 id="about-playlist" class="font-display text-xl font-semibold text-ivory">About this playlist</h2>
        <p>
          These are my piano covers. Most are from Genshin Impact,
          sorted by region from Mondstadt to Snezhnaya, with the event and Archon Quest music under
          Genshin Impact (Others). The rest are anime, pop, film and other games.
        </p>
        <p>
          Press Play all for a long calm session to study, read or fall asleep to, or pick a region to
          stay in one place. Most tracks have a free score: tap Sheet music on a track to download it.
          The arranger is credited on each score page.
        </p>
      </section>
      <CoffeeButton
        variant="inline"
        message="This whole playlist is free to stream. If it's keeping you company while you study or wind down, a coffee helps keep it going."
      />
    </div>
  </PlaylistPlayer>
</Layout>
