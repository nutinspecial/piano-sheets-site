---
// src/pages/playlist.astro
// ── Ambient piano playlist: browse/search + continuous shuffle player ─────
import CoffeeButton from "../components/CoffeeButton.astro";
import PlaylistPlayer from "../components/PlaylistPlayer.astro";
import SceneHeader from "../components/SceneHeader.astro";
import Layout from "../layouts/Layout.astro";
import tracks from "../data/tracks.json";

const totalMinutes = Math.round(tracks.reduce((sum, t) => sum + t.duration, 0) / 60);

const nodKraiCount = tracks.filter((t) => t.category === "Nod Krai").length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicPlaylist",
  "name": "Big Piano Small Piano: Ambient Piano Playlist",
  "description": "Free ambient piano music to study, sleep or relax to. Original piano covers, streamed continuously.",
  "url": "https://bigpianosmallpiano.com/playlist",
  "numTracks": tracks.length,
};
---

<Layout
  floatingCoffee={false}
  title="Piano Music for Studying &amp; Sleeping: Free Playlist"
  description="Free ambient piano playlist with hundreds of original piano covers to study, sleep or relax to. Search, filter by mood, and stream continuously. No ads, no sign-up."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO -->
  <SceneHeader region="Fontaine" eyebrow="Ambient piano" title="Piano Playlist">
    <p class="mt-3 text-ivory/80 text-sm max-w-md leading-relaxed drop-shadow">
      {tracks.length} original piano covers &middot; ~{totalMinutes} minutes &middot; free to stream, no ads.
    </p>
    {nodKraiCount > 0 && (
      <a
        href="/playlist/nod-krai"
        class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-gold/40 bg-ebony/60 backdrop-blur-sm text-gold hover:bg-gold/20 transition-colors"
      >
        ❄ Nod Krai region playlist ({nodKraiCount}) &rarr;
      </a>
    )}
  </SceneHeader>

  <!-- The header painting follows the region chip. Inline + delegated so it
       also catches the chip that ?region= presses on load. -->
  <script is:inline>
    document.addEventListener("click", function (e) {
      var chip = e.target.closest && e.target.closest(".chip-btn");
      var scene = document.getElementById("scene");
      if (!chip || !scene) return;
      var painted = ["fontaine", "inazuma", "liyue", "mondstadt", "natlan", "nod-krai", "snezhnaya", "sumeru"];
      var key = (chip.dataset.category || "").toLowerCase().replace(/[^a-z]+/g, "-");
      if (painted.indexOf(key) === -1) key = "fontaine";
      if (scene.dataset.art === key) return;
      scene.dataset.art = key;
      var img = scene.querySelector(".scene-art img"), src = scene.querySelector(".scene-art source");
      img.style.opacity = "0";
      setTimeout(function () {
        img.onload = function () { img.style.opacity = "1"; };
        src.srcset = "/art/" + key + "-m.webp";
        img.src = "/art/" + key + ".webp";
      }, 300);
    }, true);
  </script>

  <PlaylistPlayer tracks={tracks}>
    <div slot="footer">
      <CoffeeButton
        variant="inline"
        message="This whole playlist is free to stream. If it's keeping you company while you study or wind down, a coffee helps keep it going."
      />
    </div>
  </PlaylistPlayer>
</Layout>
