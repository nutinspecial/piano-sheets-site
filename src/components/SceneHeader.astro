---
// src/components/SceneHeader.astro
// ── Region painting header (the Overture look, light edition) ─────────────
// The painting fills the window behind the whole page (fixed, so it stays put
// as you scroll) and cards over it turn to frosted glass. Regions with no
// painting get a dark header with a soft gold glow. While any track on the
// page plays, the painting comes alive in that region's own way, in time
// with the music: Inazuma petals, Fontaine light and bubbles, Sumeru leaves, Liyue
// lanterns, Mondstadt breeze, Natlan cinders, Nod Krai moonlight, Snezhnaya
// snow. Loud notes throw bigger bursts, soft passages stay sparse, and a
// region-tinted glow breathes with the volume. It reads the track's
// precomputed loudness curve (public/envelopes/<file>.txt, 20 frames a
// second, digits 0-z) because the audio host sends no CORS header, so live
// analysis is not possible. Still image for reduced motion. Canvas 2D only:
// score pages must stay fast.
interface Props {
  region?:  string | null;  // "Fontaine", "Nod-Krai", "Nod Krai" ...
  eyebrow?: string;
  title:    string;
  /** Lets a page swap the painting later (the playlist chips do). */
  id?:      string;
}
const { region = null, eyebrow, title, id = "scene" } = Astro.props;

const PAINTED = ["fontaine", "inazuma", "liyue", "mondstadt", "natlan", "nod-krai", "snezhnaya", "sumeru"];
const key = region?.toLowerCase().replace(/[^a-z]+/g, "-") ?? "";
const art = PAINTED.includes(key) ? key : null;
---

<header id={id} class:list={["scene", { "scene--plain": !art }]} data-art={art ?? ""}>
  {art && (
    <picture class="scene-art" aria-hidden="true">
      <source media="(max-width: 640px)" srcset={`/art/${art}-m.webp`} />
      <img src={`/art/${art}.webp`} alt="" width="1600" height="907" fetchpriority="high" decoding="async" />
    </picture>
  )}
  <canvas class="scene-ripples" aria-hidden="true"></canvas>
  <div class="scene-fade" aria-hidden="true"></div>

  <div class="scene-body max-w-4xl mx-auto px-4 sm:px-6">
    <slot name="top" />
    {eyebrow && <p class="scene-eyebrow text-ivory/90 text-xs tracking-[0.25em] uppercase font-mono mb-3">{eyebrow}</p>}
    <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-ivory leading-[1.05] drop-shadow-lg">{title}</h1>
    <slot />
  </div>
</header>

<style is:global>
  /* The painting, its fade and the effects canvas are fixed to the viewport and
     sit behind the whole page (negative z in the root stacking context, so the
     header must not isolate), so the effects carry on as you scroll. */
  .scene { position: relative; display: flex; align-items: flex-end;
           min-height: clamp(300px, 52vh, 520px); padding: 6rem 0 2.5rem; }
  .scene--plain { min-height: 0; padding-top: 3.5rem;
                  background: radial-gradient(70% 120% at 50% 0%, theme('colors.gold.DEFAULT / 14%'), transparent 70%); }
  .scene-art, .scene-art img { position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3; }
  .scene-art img { transition: opacity .6s ease; }
  .scene-fade { position: fixed; inset: 0; z-index: -2; pointer-events: none;
                background: linear-gradient(to bottom, rgb(13 13 13 / .35) 0%, rgb(13 13 13 / .2) 30%, rgb(13 13 13 / .55) 65%, rgb(13 13 13 / .72) 100%); }
  .scene-body { position: relative; width: 100%; }
  /* Small gold caps need a real halo to read over bright skies (Liyue) */
  .scene-eyebrow { text-shadow: 0 0 2px rgb(13 13 13 / .9), 0 1px 8px rgb(13 13 13 / .85), 0 0 18px rgb(13 13 13 / .6); }

  /* Music ripples: drawn on a canvas over the painting, under the fade */
  .scene-ripples { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none;
                   mix-blend-mode: screen; }
  .scene--plain .scene-ripples { display: none; }

  /* The page's own dark fill would cover the scene (html keeps the dark colour) */
  body:has(.scene:not(.scene--plain)) { background-color: transparent; }
  /* Over a painted page, cards turn to frosted glass so the scene shows through */
  body:has(.scene:not(.scene--plain)) :is(main .bg-surface, #track-list, #scores-table) {
    background-color: rgb(20 20 20 / .7); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  /* Many small cards: tint only, no blur, to keep scrolling smooth */
  body:has(.scene:not(.scene--plain)) :is(.score-card, .chip-btn:not([aria-pressed="true"])) { background-color: rgb(20 20 20 / .78); }
  @media (prefers-reduced-motion: reduce) { .scene-ripples { display: none; } }
</style>

<script is:inline>
  // One flag on <html> for "a track is playing", whichever player started it,
  // and the region effects that follow that track's loudness curve.
  (function () {
    if (window.__sceneFlag) return; window.__sceneFlag = true;
    var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    var envs = {};          // file stem -> loudness string, or "" while loading / missing
    var audio = null;       // the element that is playing
    var parts = [];
    var scene, cv, ctx, w = 0, h = 0, dpr = 1, inView = true, raf = 0;
    var level = 0, slow = 0, glow = 0, lastBurst = 0, lastT = 0, carry = 0, wind = 0, clock = 0;
    var R = Math.random, TAU = Math.PI * 2;
    var rgba = function (c, a) { return "rgba(" + c + "," + Math.max(0, Math.min(1, a)).toFixed(3) + ")"; };
    var dot = function (x, y, r, c) { ctx.beginPath(); ctx.arc(x, y, r, 0, TAU); ctx.fillStyle = c; ctx.fill(); };

    var stem = function (a) {
      var f = (a.currentSrc || a.src || "").split("?")[0].split("/").pop() || "";
      return decodeURIComponent(f.replace(/\.[a-z0-9]+$/i, ""));
    };
    var loadEnv = function (a) {
      var k = stem(a);
      if (!k || k in envs) return;
      envs[k] = "";
      fetch("/envelopes/" + encodeURIComponent(k) + ".txt")
        .then(function (r) { return r.ok ? r.text() : ""; })
        .then(function (t) { envs[k] = t.trim(); }, function () {});
    };
    // 0..1 loudness at the current playback time; a gentle made-up swell if no curve
    var levelAt = function (a) {
      var e = envs[stem(a)];
      if (!e) return 0.35 + 0.25 * Math.sin(a.currentTime * 1.7) * Math.sin(a.currentTime * 0.43);
      var x = a.currentTime * 20, i = Math.floor(x), f = x - i;
      var v0 = parseInt(e.charAt(i) || "0", 36), v1 = parseInt(e.charAt(i + 1) || "0", 36);
      return (v0 + (v1 - v0) * f) / 35;
    };
    var phone = function () { return w < 640; };
    // Each look caps how many of its pieces can be on screen at once (fewer on
    // phones), so a long or loud track never floods the page
    var count = {};
    var add = function (o) {
      var cap = FX[o.fx].cap, n = count[o.fx] || 0;
      if (parts.length >= 260 || (cap && n >= cap[phone() ? 1 : 0])) return;
      o.age = 0; o.ph = R() * TAU; parts.push(o); count[o.fx] = n + 1;
    };
    // Painted cut-outs in one strip, loaded the first time a look needs them
    var sprites = {};
    var sprite = function (src) {
      if (!sprites[src]) { sprites[src] = new Image(); sprites[src].src = src; }
      var img = sprites[src];
      return img.complete && img.naturalWidth ? img : null;
    };
    // Fade in over the first second, out over the last 15% of life
    var edge = function (p, t) { return Math.min(1, p.age) * (t > 0.85 ? (1 - t) / 0.15 : 1); };

    // ── One entry per look. rate = particles a second at full volume (quiet
    // still gets 20%), one() makes a particle, burst(s) answers a note,
    // step/draw move and paint one particle, back() paints behind them all,
    // cap = [most on screen, most on a phone].
    var FX = {};

    // Underwater (Fontaine): shafts of light swaying down from the surface,
    // brightening with the music, and bubbles rising; a loud note lets out a
    // little cluster of them
    FX.underwater = {
      glow: "140,205,255", rate: 7, cap: [45, 24],
      back: function () {
        var a = 0.05 + 0.18 * glow;
        for (var i = 0; i < 5; i++) {
          var x = w * (0.12 + i * 0.2) + Math.sin(clock * 0.25 + i * 2.1) * w * 0.04;
          var top = 0.03 * w + 0.02 * w * Math.sin(clock * 0.4 + i), bot = top * 3.2, lean = w * 0.12;
          var g = ctx.createLinearGradient(0, 0, 0, h * 0.85);
          g.addColorStop(0, rgba("230,245,255", a * (0.75 + 0.25 * Math.sin(clock * 0.9 + i * 1.3))));
          g.addColorStop(1, rgba("230,245,255", 0));
          ctx.beginPath(); ctx.moveTo(x - top, 0); ctx.lineTo(x + top, 0);
          ctx.lineTo(x + lean + bot, h * 0.85); ctx.lineTo(x + lean - bot, h * 0.85); ctx.closePath();
          ctx.fillStyle = g; ctx.fill();
        }
      },
      one: function (s, fresh, x, y) {
        var z = 0.3 + R() * 0.7;
        add({ fx: "underwater", x: x == null ? w * R() : x + (R() - 0.5) * 30, y: y == null ? h + 10 : y + (R() - 0.5) * 20,
              z: z, r: (2.2 + R() * 5) * z * (x == null ? 1 : 0.8 + 0.6 * s), vy: -(20 + 45 * z), life: 9 + R() * 5 });
      },
      burst: function (s) {
        if (s < 0.35) return;
        var x = w * (0.1 + R() * 0.8), y = h * (0.55 + R() * 0.4);
        for (var i = Math.round(3 + 8 * s); i > 0; i--) this.one(s, true, x, y);
      },
      step: function (p, dt) {
        p.y += p.vy * dt; p.x += Math.sin(p.age * 3 + p.ph) * 12 * p.z * dt;
        if (p.y < -10) p.age = p.life;
      },
      draw: function (p, t) {
        var a = edge(p, t) * (0.4 + 0.6 * p.z), r = p.r;
        var g = ctx.createRadialGradient(p.x, p.y, r * 0.2, p.x, p.y, r);
        g.addColorStop(0, rgba("200,235,255", 0.04 * a)); g.addColorStop(0.8, rgba("200,235,255", 0.14 * a));
        g.addColorStop(1, rgba("235,248,255", 0.55 * a));
        dot(p.x, p.y, r, g);
        dot(p.x - r * 0.35, p.y - r * 0.35, Math.max(0.6, r * 0.22), rgba("255,255,255", 0.8 * a));
      }
    };

    // Sakura petals (painted cut-outs) drifting and tumbling down; a loud note
    // brings a gust
    FX.petals = {
      glow: "235,160,215", rate: 7, cap: [50, 28],
      one: function (s, fresh) {
        var z = 0.3 + R() * 0.7;
        add({ fx: "petals", x: -0.1 * w + R() * w * 1.1, y: fresh ? -20 : R() * h * 0.5, z: z, cell: Math.floor(R() * 8),
              vx: (10 + R() * 18) * z, vy: (14 + R() * 22) * (0.5 + z), size: (9 + 15 * z) * (0.85 + 0.3 * s),
              rot: R() * TAU, vr: (R() - 0.5) * 2.5, life: 16 });
      },
      burst: function (s) { wind += 60 * s; for (var i = Math.round(1 + 6 * s); i > 0; i--) this.one(s, R() < 0.6); },
      step: function (p, dt) {
        p.x += (p.vx + wind * p.z + Math.sin(p.age * 1.6 + p.ph) * 16 * p.z) * dt; p.y += p.vy * dt;
        p.rot += (p.vr + wind * 0.01) * dt; if (p.y > h + 24) p.age = p.life;
      },
      draw: function (p, t) {
        var img = sprite("/art/petals.webp"); if (!img) return;
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);
        // Turning over in the air: squash on both axes at different speeds
        ctx.scale(0.35 + 0.65 * Math.abs(Math.cos(p.age * 1.7 + p.ph)), 0.5 + 0.5 * Math.abs(Math.sin(p.age * 1.1 + p.ph)));
        ctx.globalAlpha = edge(p, t) * (0.55 + 0.45 * p.z);
        ctx.drawImage(img, p.cell * 64, 0, 64, 64, -p.size / 2, -p.size / 2, p.size, p.size);
        ctx.restore();
      }
    };

    // Forest leaves (painted cut-outs): bigger and slower than petals, rocking
    // side to side as they fall; a loud note shakes a few more loose
    FX.leaves = {
      glow: "150,215,110", rate: 3.5, cap: [24, 14],
      one: function (s, fresh) {
        var z = 0.3 + R() * 0.7;
        add({ fx: "leaves", x: -0.05 * w + R() * w * 1.1, y: fresh ? -30 : R() * h * 0.5, z: z, cell: Math.floor(R() * 8),
              vx: (-6 + R() * 14) * z, vy: (12 + R() * 16) * (0.5 + z), size: (16 + 26 * z) * (0.85 + 0.3 * s),
              rot: R() * TAU, vr: (R() - 0.5) * 1.5, life: 20 });
      },
      burst: function (s) { wind += 35 * s; for (var i = Math.round(s * 4); i > 0; i--) this.one(s, R() < 0.6); },
      step: function (p, dt) {
        p.x += (p.vx + wind * 0.6 * p.z + Math.sin(p.age * 1.3 + p.ph) * 24 * p.z) * dt; p.y += p.vy * dt;
        p.rot += (p.vr + Math.cos(p.age * 1.3 + p.ph) * 0.7) * dt; if (p.y > h + 40) p.age = p.life;
      },
      draw: function (p, t) {
        var img = sprite("/art/leaves.webp"); if (!img) return;
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);
        ctx.scale(0.45 + 0.55 * Math.abs(Math.sin(p.age * 1.4 + p.ph)), 1);
        ctx.globalAlpha = edge(p, t) * (0.6 + 0.4 * p.z);
        ctx.drawImage(img, p.cell * 96, 0, 96, 96, -p.size / 2, -p.size / 2, p.size, p.size);
        ctx.restore();
      }
    };

    // Lanterns rising slowly, their light pulsing with the volume
    FX.lanterns = {
      glow: "255,170,80", rate: 0.9, cap: [14, 8],
      // Painted sky lanterns (public/art/lanterns.webp: 4 cut-outs, 96x128
      // each, transparent).
      // z is depth: far lanterns are small, dim and slow. Steady ones rise from
      // the bottom edge; ones a note sets off appear partway up, so the sky
      // fills without a long wait
      one: function (s, fresh) {
        var z = 0.25 + R() * 0.75 * (0.6 + 0.4 * s);
        add({ fx: "lanterns", x: w * (0.04 + R() * 0.92), y: fresh ? h + 70 : h * (0.4 + R() * 0.55),
              vy: -(5 + 17 * z), z: z, cell: Math.floor(R() * 4), life: 26 + R() * 10 });
      },
      burst: function (s) { if (s > 0.2) this.one(s, false); },
      step: function (p, dt) {
        p.y += p.vy * dt; p.x += Math.sin(p.age * 0.5 + p.ph) * 5 * p.z * dt;
        if (p.y < -90) p.age = p.life;
      },
      draw: function (p, t) {
        var img = sprite("/art/lanterns.webp"); if (!img) return;
        var ht = (16 + 46 * p.z) * (phone() ? 0.75 : 1), wd = ht * 0.75;
        var a = edge(p, t) * (0.45 + 0.55 * p.z);
        var flick = 0.9 + 0.1 * Math.sin(p.age * 9 + p.ph) * Math.sin(p.age * 3.7);
        var cy = p.y + ht * 0.3;          // the flame sits near the bottom of the lantern
        // Warm halo that swells with the music
        var g = ctx.createRadialGradient(p.x, cy, 0, p.x, cy, ht * 1.3);
        g.addColorStop(0, rgba("255,170,70", a * flick * (0.18 + 0.32 * level)));
        g.addColorStop(1, rgba("255,120,40", 0));
        ctx.fillStyle = g; ctx.fillRect(p.x - ht * 1.3, cy - ht * 1.3, ht * 2.6, ht * 2.6);
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(Math.sin(p.age * 0.6 + p.ph) * 0.05);
        ctx.globalAlpha = a * flick;
        ctx.drawImage(img, p.cell * 96, 0, 96, 128, -wd / 2, -ht / 2, wd, ht);
        // Loud passages make the paper glow hotter
        ctx.globalCompositeOperation = "lighter"; ctx.globalAlpha = a * 0.45 * level;
        ctx.drawImage(img, p.cell * 96, 0, 96, 128, -wd / 2, -ht / 2, wd, ht);
        ctx.restore();
      }
    };

    // Wind streaks and dandelion seeds sweeping across
    FX.breeze = {
      glow: "200,240,205", rate: 4, cap: [40, 22],
      one: function () {
        add({ fx: "breeze", seed: true, x: -10, y: h * (0.1 + R() * 0.7), vx: 50 + R() * 50, vy: -(4 + R() * 10),
              size: 2 + R() * 2, life: 18 });
      },
      burst: function (s) {
        for (var i = s > 0.7 ? 2 : 1; i > 0; i--)
          add({ fx: "breeze", x: -0.2 * w * R(), y: h * (0.12 + R() * 0.6), vx: (220 + R() * 160) * (0.6 + s),
                len: (140 + R() * 180) * (0.6 + s), amp: 6 + R() * 14, s: s, life: 6 });
        for (var j = Math.round(4 * s); j > 0; j--) this.one();
      },
      step: function (p, dt) {
        p.x += p.vx * dt * (p.seed ? 1 + level : 1);
        if (p.seed) p.y += (p.vy + Math.sin(p.age * 2 + p.ph) * 10) * dt;
        if (p.x - (p.len || 0) > w + 20) p.age = p.life;
      },
      draw: function (p, t) {
        if (p.seed) {
          var sa = 0.85 * edge(p, t);
          dot(p.x, p.y, p.size * 0.5, rgba("255,255,240", sa));
          ctx.strokeStyle = rgba("255,255,240", sa * 0.6); ctx.lineWidth = 0.7;
          for (var k = 0; k < 6; k++) {
            var an = k / 6 * TAU + p.age; ctx.beginPath(); ctx.moveTo(p.x, p.y);
            ctx.lineTo(p.x + Math.cos(an) * p.size * 2, p.y + Math.sin(an) * p.size * 2); ctx.stroke();
          }
          return;
        }
        ctx.beginPath();
        for (var x = 0; x <= p.len; x += 8) {
          var xx = p.x - x, yy = p.y + Math.sin(xx / 70 + p.ph) * p.amp;
          if (x) ctx.lineTo(xx, yy); else ctx.moveTo(xx, yy);
        }
        ctx.lineCap = "round"; ctx.lineWidth = 1.2 + 1.4 * p.s;
        var g = ctx.createLinearGradient(p.x, 0, p.x - p.len, 0);
        g.addColorStop(0, rgba("245,255,240", 0.75 * (0.4 + 0.6 * p.s))); g.addColorStop(1, rgba("245,255,240", 0));
        ctx.strokeStyle = g; ctx.stroke();
      }
    };

    // Embers floating up from the bottom, flickering
    FX.cinders = {
      glow: "255,110,40", rate: 14, cap: [80, 40],
      one: function (s) {
        add({ fx: "cinders", x: w * R(), y: h + 6, vx: (R() - 0.5) * 20, vy: -(30 + R() * 50) * (0.7 + 0.6 * s),
              size: 0.9 + R() * 1.8 * (0.6 + s), life: 2.5 + R() * 3 });
      },
      burst: function (s) { for (var i = Math.round(6 + 22 * s); i > 0; i--) this.one(s); },
      step: function (p, dt) { p.x += (p.vx + Math.sin(p.age * 3 + p.ph) * 14) * dt; p.y += p.vy * dt; },
      draw: function (p, t) {
        var a = (1 - t) * (0.6 + 0.4 * Math.sin(p.age * 22 + p.ph));
        dot(p.x, p.y, p.size * 3, rgba("255,90,20", a * 0.18));
        dot(p.x, p.y, p.size, rgba(t < 0.4 ? "255,230,150" : "255,150,60", a));
      }
    };

    // Moonbeams from the top corner that brighten with the music, a halo on
    // loud notes, and silver glints drifting down
    FX.moonlight = {
      glow: "175,195,255", rate: 3, cap: [30, 16],
      // Where the painted moon sits in each crop, mapped through object-fit: cover
      moon: function () {
        var img = scene.querySelector(".scene-art img"), nw = img.naturalWidth || 1600, nh = img.naturalHeight || 907;
        var crop = /-m\.webp/.test(img.currentSrc), sc = Math.max(w / nw, h / nh);
        return [(w - nw * sc) / 2 + (crop ? 0.275 : 0.328) * nw * sc, (h - nh * sc) / 2 + (crop ? 0.219 : 0.241) * nh * sc];
      },
      back: function () {
        var m = this.moon(), len = Math.hypot(w, h) * 1.1, a = 0.035 + 0.16 * glow;
        for (var i = 0; i < 6; i++) {
          var an = Math.PI * (0.16 + i * 0.075) + Math.sin(clock * 0.3 + i * 1.7) * 0.03, wd = 0.02 + 0.012 * (i % 3);
          var g = ctx.createLinearGradient(m[0], m[1], m[0] + Math.cos(an) * len, m[1] + Math.sin(an) * len);
          g.addColorStop(0, rgba("210,225,255", a * (0.7 + 0.3 * Math.sin(clock * 0.8 + i)))); g.addColorStop(1, rgba("210,225,255", 0));
          ctx.beginPath(); ctx.moveTo(m[0], m[1]);
          ctx.lineTo(m[0] + Math.cos(an - wd) * len, m[1] + Math.sin(an - wd) * len);
          ctx.lineTo(m[0] + Math.cos(an + wd) * len, m[1] + Math.sin(an + wd) * len);
          ctx.closePath(); ctx.fillStyle = g; ctx.fill();
        }
      },
      one: function () {
        add({ fx: "moonlight", glint: true, x: w * (0.2 + R() * 0.8), y: -6, vx: -4 - R() * 6, vy: 10 + R() * 16,
              size: 0.8 + R() * 1.3, life: 9 + R() * 5 });
      },
      burst: function (s) {
        var m = this.moon();
        add({ fx: "moonlight", x: m[0], y: m[1], r: Math.min(w, 700) * (0.12 + 0.3 * s), s: s, life: 2.6 });
        for (var i = Math.round(5 * s); i > 0; i--) this.one();
      },
      step: function (p, dt) { if (p.glint) { p.x += p.vx * dt; p.y += p.vy * dt; } },
      draw: function (p, t) {
        if (p.glint) { dot(p.x, p.y, p.size, rgba("225,235,255", 0.9 * edge(p, t) * (0.5 + 0.5 * Math.sin(p.age * 6 + p.ph)))); return; }
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (1 - Math.pow(1 - t, 3)), 0, TAU);
        ctx.lineWidth = 1.5 + 2 * p.s * (1 - t); ctx.strokeStyle = rgba("220,230,255", Math.pow(1 - t, 1.5) * (0.3 + 0.5 * p.s)); ctx.stroke();
      }
    };

    // Snow: small flakes always, six-armed stars on loud notes
    FX.snow = {
      glow: "200,225,255", rate: 16, cap: [110, 55],
      one: function (s, fresh, star) {
        add({ fx: "snow", x: w * R() * 1.1 - w * 0.05, y: fresh ? -8 : R() * h * 0.4, vx: -6 + R() * 12,
              vy: star ? 18 + R() * 14 : 16 + R() * 30, star: star, rot: R() * TAU,
              size: star ? (5 + R() * 5) * (0.7 + 0.5 * s) : 1 + R() * 2.2, life: 16 });
      },
      burst: function (s) {
        for (var i = Math.round(4 + 12 * s); i > 0; i--) this.one(s, R() < 0.5, false);
        if (s > 0.5) for (var j = s > 0.8 ? 2 : 1; j > 0; j--) this.one(s, R() < 0.5, true);
      },
      step: function (p, dt) {
        p.x += (p.vx + Math.sin(p.age * 1.3 + p.ph) * 9) * dt; p.y += p.vy * dt; p.rot += 0.4 * dt;
        if (p.y > h + 12) p.age = p.life;
      },
      draw: function (p, t) {
        var a = 0.9 * edge(p, t);
        if (!p.star) { dot(p.x, p.y, p.size, rgba("245,250,255", a)); return; }
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);
        ctx.strokeStyle = rgba("240,248,255", a); ctx.lineWidth = 1.1; ctx.lineCap = "round";
        for (var k = 0; k < 6; k++) {
          ctx.rotate(TAU / 6); ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, -p.size);
          ctx.moveTo(0, -p.size * 0.55); ctx.lineTo(p.size * 0.25, -p.size * 0.78);
          ctx.moveTo(0, -p.size * 0.55); ctx.lineTo(-p.size * 0.25, -p.size * 0.78); ctx.stroke();
        }
        ctx.restore();
      }
    };

    var LOOK = { inazuma: "petals", fontaine: "underwater", sumeru: "leaves", liyue: "lanterns",
                 mondstadt: "breeze", natlan: "cinders", "nod-krai": "moonlight", snezhnaya: "snow" };

    var size = function () {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = cv.clientWidth; h = cv.clientHeight;
      cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    var frame = function (now) {
      raf = 0;
      var dt = Math.min(0.05, lastT ? (now - lastT) / 1000 : 0.016); lastT = now; clock += dt;
      var playing = audio && !audio.paused && !audio.ended;
      // Read the look every frame: the playlist chips swap the painting
      var fx = FX[LOOK[scene.dataset.art] || "underwater"];

      if (playing) {
        var lv = levelAt(audio);
        level += (lv - level) * 0.5;
        slow += (level - slow) * 0.03;
        // A note that jumps clear of the recent average is a burst; quiet
        // stretches still get a small one now and then so nothing goes still
        var gap = now - lastBurst;
        if ((level > slow * 1.2 + 0.03 && level > 0.08 && gap > 160) || gap > 1200) {
          fx.burst(Math.max(0.12, Math.min(1, level * 1.15)));
          lastBurst = now;
        }
        if (fx.rate) { carry += fx.rate * (0.2 + 0.8 * level) * dt; for (; carry >= 1; carry--) fx.one(level, true, false); }
      } else level *= 0.94;
      glow += (level - glow) * 0.08;
      wind *= Math.pow(0.4, dt);

      ctx.clearRect(0, 0, w, h);
      if (glow > 0.01) {
        var gx = w * (phone() ? 0.5 : 0.7), gy = h * 0.32, gr = Math.max(w, h) * 0.55;
        var g = ctx.createRadialGradient(gx, gy, 0, gx, gy, gr);
        g.addColorStop(0, rgba(fx.glow, 0.04 + 0.22 * glow)); g.addColorStop(1, rgba(fx.glow, 0));
        ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
        if (fx.back) fx.back();
      }
      for (var i = parts.length - 1; i >= 0; i--) {
        var p = parts[i], kind = FX[p.fx];
        p.age += dt;
        if (p.age < p.life) kind.step(p, dt);
        if (p.age >= p.life) { parts.splice(i, 1); count[p.fx]--; continue; }
        kind.draw(p, p.age / p.life);
      }

      if (inView && (playing || parts.length || glow > 0.01)) raf = requestAnimationFrame(frame);
      else lastT = 0;
    };
    var kick = function () { if (!raf && cv && inView) raf = requestAnimationFrame(frame); };

    var sync = function (e) {
      var on = Array.prototype.some.call(document.querySelectorAll("audio"), function (a) { return !a.paused; });
      document.documentElement.classList.toggle("is-playing", on);
      if (e && e.type === "play" && e.target.tagName === "AUDIO") { audio = e.target; loadEnv(audio); }
      kick();
    };
    ["play", "pause", "ended"].forEach(function (t) { document.addEventListener(t, sync, true); });

    var init = function () {
      cv = document.querySelector("canvas.scene-ripples");
      if (!cv || reduced || getComputedStyle(cv).display === "none") { cv = null; return; }
      scene = cv.closest(".scene"); ctx = cv.getContext("2d");
      size(); addEventListener("resize", size);
      // No drawing while the header is scrolled away
      new IntersectionObserver(function (es) { inView = es[0].isIntersecting; kick(); }).observe(cv);
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init); else init();
  })();
</script>
